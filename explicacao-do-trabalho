# Código da Atividade - Modelos de Camisetas

# Definição das listas de referência e da matriz principal de estoque
modelos = ["Modelo 1", "Modelo 2", "Modelo 3", "Modelo 4"]
tamanhos = ["P", "M", "G"]
estoque = []

# Cadastro inicial: percorre cada modelo e tamanho para preencher a matriz
for modelo in modelos:
    linha = []
    for tamanho in tamanhos:
        qtd = int(input(f"{modelo}, tamanho {tamanho}: "))
        # Validação para impedir que o usuário digite números negativos
        while qtd < 0:
            print("Quantidade inválida!")
            qtd = int(input("Digite novamente: "))
        linha.append(qtd)
    estoque.append(linha)

# Menu interativo principal em execução contínua
while True:
    print("\n1-Consultar  2-Vender  3-Repor estoque")
    print("4-Estoque abaixo de 3  5-Mostrar tudo  6-Sair")
    op = input("Escolha: ")

    # Opção 6: Encerra o laço e finaliza o programa
    if op == "6":
        print("Programa encerrado!")
        break

    # Opção 4: Varre toda a matriz verificando itens com menos de 3 unidades
    elif op == "4":
        for i in range(4):
            for j in range(3):
                if estoque[i][j] < 3:
                    print(modelos[i], tamanhos[j], estoque[i][j])

    # Opção 5: Exibe a tabela completa com todos os modelos e tamanhos
    elif op == "5":
        print("       P   M   G")
        for i in range(4):
            print(modelos[i], estoque[i])

    # Opções 1, 2 e 3: Operações específicas de consulta, venda ou reposição
    elif op in ["1", "2", "3"]:
        m = int(input("Modelo (1 a 4): "))
        t = input("Tamanho (P, M ou G): ").upper()

        # Validação para garantir que o modelo e o tamanho existem
        if m < 1 or m > 4 or t not in tamanhos:
            print("Modelo ou tamanho inválido!")
            continue

        # Conversão das entradas para os índices reais da matriz (iniciados em zero)
        i = m - 1
        j = tamanhos.index(t)

        # Opção 1: Consulta a quantidade disponível no estoque
        if op == "1":
            print("Quantidade disponível:", estoque[i][j])

        # Opções 2 e 3: Venda ou reposição de mercadorias
        else:
            qtd = int(input("Quantidade: "))

            # Validação para impedir movimentações nulas ou negativas
            if qtd <= 0:
                print("A quantidade deve ser maior que zero!")

            # Validação de saldo suficiente antes de concluir a venda
            elif op == "2" and qtd > estoque[i][j]:
                print("Estoque insuficiente!")

            # Realiza a baixa no estoque em caso de venda
            elif op == "2":
                estoque[i][j] -= qtd
                print("Venda realizada!")

            # Realiza o acréscimo no estoque em caso de reposição
            else:
                estoque[i][j] += qtd
                print("Estoque atualizado!")

    # Tratamento para qualquer opção digitada fora do menu
    else:
        print("Opção inválida!")
