#Questão 2

def calcular_media(nota_um,nota_dois):
  media = (nota_um+nota_dois) / 2
  return media


def definir_situacao(media):
  if media >= 7:
    return 'Aprovado'
  else:
    return 'Reprovado'


nota_um = float(input('Digite sua primeira nota: '))
nota_dois = float(input('Digite sua segunda nota: '))


media_estudante = calcular_media(nota_um,nota_dois)
situacao = definir_situacao(media_estudante)

print(f'Média {media_estudante}.')
print(f'Situação:{situacao}')

